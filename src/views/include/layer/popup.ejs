<div class="popup">
  <button type="button" class="btn_close">
    <span class="blind">팝업 닫기</span>
  </button>
  <div class="box_popup_swiper">
    <div class="swiper-wrapper">
      <div class="swiper-slide">
        <div class="box_popup_img">
          <img src="../img/popup/popup_01.jpg" alt="">
        </div>
        <div class="box_btn">
          <a href="#" class="btn_popup">
            <span class="blind">자세히 보기</span>
          </a>
          <a href="#" class="btn_popup">
            <span class="blind">자세히 보기 2</span>
          </a>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="box_popup_img">
          <img src="../img/popup/popup_02.jpg" alt="">
        </div>
      </div>
    </div>
  </div>
  <div class="box_popup_footer">
    <div class="box_popup_checkbox">
      <input type="checkbox" class="blind" id="popup_today">
      <label for="popup_today" class="label">오늘 하루 보지 않기</label>
    </div>
    <div class="box_swiper_control">
      <button type="button" class="btn_prev">
        <span class="blind">이전</span>
      </button>
      <div class="swiper-pagination"></div>
      <button type="button" class="btn_next">
        <span class="blind">다음</span>
      </button>
    </div>
  </div>
</div>
