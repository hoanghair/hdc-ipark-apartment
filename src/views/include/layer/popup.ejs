<div class="popup">
  <div class="box_until">
    <div class="box_popup_checkbox">
      <input type="checkbox" class="blind" id="popup_today">
      <label for="popup_today" class="label">오늘 하루 보지 않기</label>
    </div>
    <button type="button" class="btn_close">
      <span class="blind">팝업 닫기</span>
    </button>
  </div>
  <div class="box_popup_swiper">
    <div class="swiper-wrapper">
      <div class="swiper-slide">
        <div class="box_popup_img">
          <img src="https://placecats.com/300/200" alt="">
        </div>
      </div>
      <div class="swiper-slide">
        <div class="box_popup_img">
          <img src="https://placecats.com/400/400" alt="">
        </div>
        <div class="box_btn">
          <a href="#" class="btn_popup">자세히 보기</a>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="box_popup_img">
          <img src="https://placecats.com/500/200" alt="">
        </div>
        <div class="box_btn">
          <a href="#" class="btn_popup type_download">다운로드</a>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="box_popup_img">
          <img src="https://placecats.com/500/200" alt="">
        </div>
        <div class="box_btn">
          <a href="#" class="btn_popup type_download">다운로드</a>
          <a href="#" class="btn_popup">자세히 보기</a>
        </div>
      </div>
    </div>
  </div>
  <div class="box_swiper_control">
    <button type="button" class="btn_prev">
      <span class="blind">이전</span>
    </button>
    <div class="swiper-pagination"></div>
    <button type="button" class="btn_next">
      <span class="blind">다음</span>
    </button>
  </div>
  
</div>