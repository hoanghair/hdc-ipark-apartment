<% const title = locals.title || ''; %>
<% const desc = locals.desc || ''; %>
<% const useInput = locals.useInput || false; %>
<% const btnText1 = locals.btnText1 || ''; %>
<% const btnText2 = locals.btnText2 || ''; %>

<div class="layer" style="display: none;">
  <div class="layer_inner">
    <strong class="title"><%= title %></strong>
    <p class="desc"><%- desc %></p>
    <% if(useInput){ %>
      <div class="box_input_id">
        <label for="finde_id" class="label">아이디</label>
        <input type="text" id="finde_id" placeholder="아이디를 입력하세요." class="input" />
      </div>
    <% } %>
    <div class="box_btn">
      <%-include('../button/btn.ejs', {
        text: btnText1,
        className: 'type_secondary',
      })%>
      <%-include('../button/btn.ejs', {
        text: btnText2,
      })%>
    </div>
    
    <button type="button" class="btn_close">
      <span class="blind">닫기</span>
    </button>
  </div>
</div>