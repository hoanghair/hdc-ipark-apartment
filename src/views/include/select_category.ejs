<% const selectId = locals.id || 'select-' + Math.random().toString(36).substr(2, 9); %>
<% const selectLabel = locals.label || '카테고리 선택'; %>
<% const options = locals.options || []; %>
<% const selectedIndex = locals.selectedIndex || 0; %>
<% const selectedText = options[selectedIndex] || options[0] || '선택하세요'; %>

<div class="select_category" data-select-id="<%= selectId %>">
  <button
    type="button"
    class="btn_category_select"
    id="<%= selectId %>-btn"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-labelledby="<%= selectId %>-btn"
  >
    <%= selectedText %>
  </button>
  <ul
    class="list_category"
    role="listbox"
    aria-labelledby="<%= selectId %>-btn"
    aria-label="<%= selectLabel %>"
    tabindex="-1"
  >
    <% options.forEach(function(option, index) { %>
    <li
      class="item_category"
      role="option"
      aria-selected="<%= index === selectedIndex %>"
      data-index="<%= index %>"
    >
      <button type="button" class="btn_category_item"><%= option %></button>
    </li>
    <% }); %>
  </ul>
</div>
