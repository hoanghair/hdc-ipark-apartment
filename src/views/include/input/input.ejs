<% const id = locals.id || ''; %>
<% const name = locals.name || ''; %>
<% const label = locals.label || ''; %>
<% const type = locals.type || ''; %>
<% const placeholder = locals.placeholder || ''; %>
<% const readonly = locals.readonly || false; %>
<% const value = locals.value || ''; %>
<% const className = locals.className || ''; %>

<div class="box_input <%= className %>">
  <% if (label) { %>
    <label for="<%= id %>" class="label <%= className %>"><%= label %></label>
  <% } %>
  <input type="<%= type %>" id="<%= id %>" placeholder="<%= placeholder %>" class="input" <%= readonly ? 'readonly' : '' %> value="<%= value %>" />
</div>