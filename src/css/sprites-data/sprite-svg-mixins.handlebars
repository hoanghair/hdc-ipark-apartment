      background-position: calc((math.div(map-get($image-var, "offset-x"), 1px) - math.div($padding, 1px)) / math.div(map-get($image-var, "width"), 1px) * math.div($size, 1px) / 360 * 100vw) calc((math.div(map-get($image-var, "offset-y"), 1px) - math.div($padding, 1px)) / math.div(map-get($image-var, "width"), 1px) * math.div($size, 1px) / 360 * 100vw);
    }
