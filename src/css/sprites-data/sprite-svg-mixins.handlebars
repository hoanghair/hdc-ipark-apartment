@use 'sass:math';

${{spriteName}}-svg-origin: (
  total-width: {{spriteWidth}}px,
  total-height: {{spriteHeight}}px,
  padding: {{padding.top}}px,
  imageSrc: '{{{baseName}}}.svg'
);

${{spriteName}}-svg-vars: (
  {{#shapes}}
  '{{name}}': (
    offset-x: {{position.absolute.x}}px,
    offset-y: {{position.absolute.y}}px,
    width: {{width.inner}}px,
    height: {{height.inner}}px
  ),
  {{/shapes}}
);
@function get-ratio($width, $height) {
    @return parse-int($width / $height);
}

@function get-scale($width, $new-width) {
    @return parse-int($new-width / $width);
}

@mixin useSvg-{{spriteName}}($image, $size: false) {
  {{!-- 변수 --}}
  $image-origin: ${{spriteName}}-svg-origin;
  $image-var: map-get(${{spriteName}}-svg-vars, $image);
  $image-path: map-get($image-origin, 'imageSrc');
  $padding: map-get(${{spriteName}}-svg-origin, 'padding');

  background-image: url($image-path);
  background-repeat: no-repeat;

  {{!-- 적용 --}}
  @if($size){
    @if(unitless($size)){
      @warn '"#{$size}" of "#{$image}" is unitless value. Please insert value with unit(px)';
    }
    @else {
      {{!-- 1439px 이하: 1440 기준 --}}
      @media (max-width: 1439px) {
        $adjusted-size: calc($size * 1440 / 1920);
        $aspectRatio: calc(map-get($image-var, 'height') / map-get($image-var, 'width'));
        $sizeRatio: calc($adjusted-size / map-get($image-var, 'width'));
        
        width: $adjusted-size;
        height: calc($adjusted-size * #{$aspectRatio});
        background-size: calc(#{map-get($image-origin, 'total-width')} * #{$sizeRatio}) calc(#{map-get($image-origin, 'total-height')} * #{$sizeRatio});
        background-position: calc((#{map-get($image-var, 'offset-x')} - #{$padding}) * #{$sizeRatio}) calc((#{map-get($image-var, 'offset-y')} - #{$padding}) * #{$sizeRatio});
      }

      {{!-- 1440~2560: vw 적용 --}}
      @media (min-width: 1440px) and (max-width: 2560px) {
        width: calc(math.div($size, 1px) / 1920 * 100vw);
        height: calc(math.div($size, 1px) / 1920 * 100vw * math.div(map-get($image-var, "height"), 1px) / math.div(map-get($image-var, "width"), 1px));
        background-size: calc( math.div(map-get($image-origin, "total-width"), 1px) / math.div(map-get($image-var, "width"), 1px) * math.div($size, 1px) / 1920 * 100vw) calc( math.div(map-get($image-origin, "total-height"), 1px) / math.div(map-get($image-var, "width"), 1px) * math.div($size, 1px) / 1920 * 100vw);
        background-position: calc((math.div(map-get($image-var, "offset-x"), 1px) - math.div($padding, 1px)) /  math.div(map-get($image-var, "width"), 1px) * math.div($size, 1px) / 1920 * 100vw) calc(( math.div(map-get($image-var, "offset-y"), 1px) - math.div($padding, 1px)) / math.div(map-get($image-var, "width"), 1px) * math.div($size, 1px) / 1920 * 100vw);
      }

      {{!-- 2561px 이상: 2560 기준 --}}
      @media (min-width: 2561px) {
        $adjusted-size: calc($size * 2560 / 1920);
        $aspectRatio: calc(map-get($image-var, 'height') / map-get($image-var, 'width'));
        $sizeRatio: calc($adjusted-size / map-get($image-var, 'width'));
        
        width: $adjusted-size;
        height: calc($adjusted-size * #{$aspectRatio});
        background-size: calc(#{map-get($image-origin, 'total-width')} * #{$sizeRatio}) calc(#{map-get($image-origin, 'total-height')} * #{$sizeRatio});
        background-position: calc((#{map-get($image-var, 'offset-x')} - #{$padding}) * #{$sizeRatio}) calc((#{map-get($image-var, 'offset-y')} - #{$padding}) * #{$sizeRatio});
      }
    }
  }
  @else {
    width: map-get($image-var, 'width');
    height: map-get($image-var, 'height');
    background-size: map-get($image-origin, 'total-width') map-get($image-origin, 'total-height');
    background-position: (map-get($image-var, 'offset-x') - $padding) (map-get($image-var, 'offset-y') - $padding);
  }
}

